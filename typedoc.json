{
  "out": "docs",
  "exclude": "+(gen-tests.ts|__tests__|node_modules|mini|build)",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "highlightLanguages": ["bash", "json", "js", "ts", "tsx", "html", "css", "jsonc", "toml", "rust"],
  "readme": "README.md",
  "cacheBust": true,
  "gitRevision": "master",
  "entryPoints": ["typedoc-entry.ts"]
}
