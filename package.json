{
  "name": "@retorquere/bibtex-parser",
  "version": "14.0.7",
  "description": "BibTeX parser",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bibtex_parser_bg.wasm": "./dist/bibtex_parser_bg.wasm"
  },
  "scripts": {
    "lint": "cargo +nightly fmt --all -- --check",
    "start": "cargo xtask start",
    "bench": "cargo xtask bench",
    "build": "cargo xtask build",
    "test": "cargo xtask test",
    "test:bibtex-parser": "node --test test/run.js",
    "test:unicode-mappings": "node --test test/unicode2latex.js test/unicode2latex-api.js",
    "test:release": "cargo xtask test-release",
    "test:rust": "cargo xtask test-rust",
    "list": "tar tvf $(npm pack)",
    "prepublishOnly": "cargo xtask publish-check",
    "prepack": "cp README.md README.md.bak && cp JavaScript.md README.md",
    "postpack": "mv README.md.bak README.md",
    "abbr": "cargo xtask abbr",
    "preversion": "cargo xtask preversion",
    "version": "cargo set-version $npm_package_version && git add Cargo.toml Cargo.lock xtask/Cargo.toml",
    "postversion": "git push --follow-tags",
    "update-cases": "curl -s https://raw.githubusercontent.com/retorquere/zotero-better-bibtex/master/test/loaded.json | jq -r '.[] | select(test(\"\\\\.bib((la)?tex)?$\"))' | rsync -av --delete -m --files-from=- ../better-bibtex/test/fixtures/ test/better-bibtex/",
    "predocs": "cargo xtask build",
    "docs": "typedoc --tsconfig tsconfig.typedoc.json",
    "modules": "(git submodule update --init --recursive || true) && (git add submodules/ || true)",
    "update-crossref": "git submodule update --init -- submodules/biber && cargo check -p bbt-bibtex-parser",
    "ncu": "npm run modules && npm run update-crossref && ncu -u && npm i && git add package.json package-lock.json && npm audit fix && git commit -m ncu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retorquere/bibtex-parser.git"
  },
  "keywords": [
    "bibtex"
  ],
  "author": "Emiliano Heyns",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "benchmark": "^2.1.4",
    "glob": "^14.0.4",
    "js-yaml": "^5.5.0",
    "minimist": "^1.2.8",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "files": [
    "README.md",
    "package.json",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
