{
  "name": "@retorquere/bibtex-parser",
  "version": "13.0.15",
  "description": "BibTeX parser",
  "type": "module",
  "module": "./dist/wasm/index.js",
  "types": "./dist/wasm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wasm/index.d.ts",
      "import": "./dist/wasm/index.js"
    },
    "./bibtex_parser_bg.wasm": "./dist/wasm/bibtex_parser_bg.wasm",
    "./bibtex_tokenizer_bg.wasm": "./dist/tokenizer/bibtex_tokenizer_bg.wasm",
    "./tokenizer": {
      "types": "./dist/tokenizer/index.d.ts",
      "import": "./dist/tokenizer/index.js",
      "default": "./dist/tokenizer/index.js"
    }
  },
  "scripts": {
    "lint": "cargo fmt --all -- --check",
    "prestart": "npm run lint",
    "start": "npm run build",
    "bench": "npm run build && node test/tokenizer-benchmark.mjs",
    "prebuild": "rm -rf dist && mkdir -p dist/data && cp data/*.json dist/data && ./build/abbr.py",
    "build": "node build-wasm.mjs",
    "pretest": "npm start",
    "test": "npm run test:rust && npm run test:wasm",
    "test:wasm": "node --test test/run.js",
    "test:release": "npm run test:rust && npm run test:wasm",
    "test:rust": "cargo test --workspace",
    "minitest": "./build/crossref.py && npm run build && node i.js",
    "list": "tar tvf $(npm pack)",
    "prepublishOnly": "npm run build && npm run test:release",
    "abbr": "./build/abbr.py",
    "preversion": "npm run abbr && npm run test:release",
    "postversion": "git push --follow-tags",
    "update-cases": "curl -s https://raw.githubusercontent.com/retorquere/zotero-better-bibtex/master/test/loaded.json | jq -r '.[] | select(test(\"\\\\.bib((la)?tex)?$\"))' | rsync -av --delete -m --files-from=- ../better-bibtex/test/fixtures/ test/better-bibtex/",
    "predocs": "npm run build",
    "docs": "typedoc --tsconfig tsconfig.typedoc.json",
    "modules": "git submodule update --init --recursive",
    "ncu": "./build/submodules.py && ./build/crossref.py && ncu -u && npm i && git add package.json package-lock.json && npm audit fix && git commit -m ncu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/retorquere/bibtex-parser.git"
  },
  "keywords": [
    "bibtex"
  ],
  "author": "Emiliano Heyns",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "benchmark": "^2.1.4",
    "command-line-args": "^6.0.2",
    "csv": "^6.6.4",
    "digital-tree": "^2.0.4",
    "dprint": "^0.64.3",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "glob": "^14.0.3",
    "js-yaml": "^5.5.0",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "node-fetch": "^3.3.2",
    "piscina": "^5.3.2",
    "slug": "^12.0.1",
    "tap": "^21.8.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-pegjs": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "@unified-latex/unified-latex-util-replace": "^1.8.4",
    "@unified-latex/unified-latex-util-visit": "^1.8.4",
    "i": "^0.3.7",
    "lodash.merge": "^4.6.2",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "unicode2latex": "^7.0.38",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "files": [
    "README.md",
    "package.json",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "dprint@0.64.3": true
  }
}
