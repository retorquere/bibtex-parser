{
  "name": "@retorquere/bibtex-parser",
  "version": "13.0.15",
  "description": "BibTeX parser",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bibtex_parser_bg.wasm": "./dist/bibtex_parser_bg.wasm",
    "./bibtex_tokenizer_bg.wasm": "./dist/tokenizer/bibtex_tokenizer_bg.wasm",
    "./unicode2latex_bg.wasm": "./dist/unicode2latex/unicode2latex_bg.wasm",
    "./tokenizer": {
      "types": "./dist/tokenizer/index.d.ts",
      "import": "./dist/tokenizer/index.js",
      "default": "./dist/tokenizer/index.js"
    },
    "./unicode2latex": {
      "types": "./dist/unicode2latex/index.d.ts",
      "import": "./dist/unicode2latex/index.js",
      "default": "./dist/unicode2latex/index.js"
    }
  },
  "scripts": {
    "lint": "cargo +nightly fmt --all -- --check",
    "prestart": "npm run lint",
    "start": "npm run build",
    "bench": "npm run build && node test/tokenizer-benchmark.mjs",
    "prebuild": "rm -rf dist && mkdir -p dist/data && cp data/*.json dist/data && node unicode2latex/build.mjs tables && ./build/abbr.py",
    "build": "node build-wasm.mjs",
    "pretest": "npm start",
    "test": "npm run test:rust && npm run test:bibtex-parser && npm run test:unicode2latex",
    "test:bibtex-parser": "node --test test/run.js",
    "test:unicode2latex": "node --test test/unicode2latex.js test/unicode2latex-api.js",
    "test:release": "npm run test:rust && npm run test:bibtex-parser && npm run test:unicode2latex",
    "test:rust": "cargo test --workspace",
    "list": "tar tvf $(npm pack)",
    "prepublishOnly": "npm run build && npm run test:release",
    "abbr": "./build/abbr.py",
    "preversion": "npm run abbr && npm run test:release",
    "postversion": "git push --follow-tags",
    "update-cases": "curl -s https://raw.githubusercontent.com/retorquere/zotero-better-bibtex/master/test/loaded.json | jq -r '.[] | select(test(\"\\\\.bib((la)?tex)?$\"))' | rsync -av --delete -m --files-from=- ../better-bibtex/test/fixtures/ test/better-bibtex/",
    "predocs": "npm run build",
    "docs": "typedoc --tsconfig tsconfig.typedoc.json",
    "modules": "git submodule update --init --recursive",
    "ncu": "./build/submodules.py && ./build/crossref.py && ncu -u && npm i && git add package.json package-lock.json && npm audit fix && git commit -m ncu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/retorquere/bibtex-parser.git"
  },
  "keywords": [
    "bibtex"
  ],
  "author": "Emiliano Heyns",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "benchmark": "^2.1.4",
    "glob": "^14.0.3",
    "js-yaml": "^5.5.0",
    "minimist": "^1.2.8",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "files": [
    "README.md",
    "package.json",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
