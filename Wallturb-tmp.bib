}

@article{andreolli-etal-2023,
  title = {Separating Large-Scale Superposition and Modulation in Turbulent Channels},
  author = {Andreolli, Andrea and Gatti, Davide and Vinuesa, Ricardo and {\"O}rl{\"u}, Ramis and Schlatter, Philipp},
  year = 2023,
