@article{aragonj.l.TurbulentLuminanceImpassioned2008,
  title = {Turbulent Luminance in Impassioned van {{Gogh}} Paintings},
  author = {{Arag\'on J. L.} and {Naumis Gerardo G.} and {Bai M.} and {Torres M.} and {Maini P. K.}},
