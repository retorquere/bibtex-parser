@article{fung-etal-1992,
  title = {Kinematic Simulation of Homogeneous Turbulence by Unsteady Random {{Fourier}} Modes},
  author = {Fung, J. C. H. and Hunt, J. C. R. and Malik, N. A. and Perkins, R. J.},
  year = 1992,
  month = mar,
  journal = {Journal of Fluid Mechanics},
  volume = {236},
  pages = {281--318},
  publisher = {Cambridge University Press},
  issn = {1469-7645, 0022-1120},
  doi = {10.1017/S0022112092001423},
  urldate = {2023-08-16},
  abstract = {The velocity field of homogeneous isotropic turbulence is simulated by a large number (38--1200) of random Fourier modes varying in space and time over a large number ({$>$} 100) of realizations. They are chosen so that the flow field has certain properties, namely (i) it satisfies continuity, (ii) the two-point Eulerian spatial spectra have a known form (e.g. the Kolmogorov inertial subrange), (iii) the time dependence is modelled by dividing the turbulence into large- and small-scales eddies, and by assuming that the large eddies advect the small eddies which also decorrelate as they are advected, (iv) the amplitudes of the large- and small-scale Fourier modes are each statistically independent and each Gaussian. The structure of the velocity field is found to be similar to that computed by direct numerical simulation with the same spectrum, although this simulation underestimates the lengths of tubes of intense vorticity.Some new results and concepts have been obtained using this kinematic simulation: (a) for the inertial subrange (which cannot yet be simulated by other means) the simulation confirms the form of the Eulerian frequency spectrum \$\textbackslash phi\textasciicircum\textbraceleft\textbackslash rm E\textbraceright\_\textbraceleft 11\textbraceright{} = C\textasciicircum\textbraceleft\textbackslash rm E\textbraceright\textbackslash epsilon\textasciicircum\textbraceleft\textbackslash frac\textbraceleft 2\textbraceright\textbraceleft 3\textbraceright\textbraceright U\textasciicircum\textbraceleft\textbackslash frac\textbraceleft 2\textbraceright\textbraceleft 3\textbraceright\textbraceright\_0\textbackslash omega\textasciicircum\textbraceleft -\textbackslash frac\textbraceleft 5\textbraceright\textbraceleft 3\textbraceright\textbraceright\$, where {$\varepsilon$},U0,{$\omega$} are the rate of energy dissipation per unit mass, large-scale r.m.s. velocity, and frequency. For isotropic Gaussian large-scale turbulence at very high Reynolds number, CE {$\approx$} 0.78, which is close to the computed value of 0.82; (b) for an observer moving with the large eddies the `Eulerian---Lagrangian' spectrum is {$\phi$}EL11 = CEL{$\varepsilon\omega-$}2, where CEL {$\approx$} 0.73; (c) for an observer moving with a fluid particle the Lagrangian spectrum {$\phi$}L11 = CL{$\varepsilon\omega-$}2, where CL {$\approx$} 0.8, a value consistent with the atmospheric turbulence measurements by Hanna (1981) and approximately equal to CEL; (d) the mean-square relative displacement of a pair of particles \textlangle{$\Delta$}2\textrangle{} tends to the Richardson (1926) and Obukhov (1941) form \textlangle{$\Delta$}2\textrangle{} = G{$\Delta\varepsilon$}t3, provided that the subrange extends over four decades in energy, and a suitable origin is chosen for the time t. The constant G{$\Delta$} is computed and is equal to 0.1 (which is close to Tatarski's 1960 estimate of 0.06); (e) difference statistics (i.e. displacement from the initial trajectory) of single particles are also calculated. The exact result that Y2 = GY{$\varepsilon$}t3 with GY = 2{$\pi$}CL is approximately confirmed (although it requires an even larger inertial subrange than that for \textlangle{$\Delta$}2\textrangle ). It is found that the ratio [Rscr    ]G = 2\textlangle Y2\textrangle/\textlangle{$\Delta$}2\textrangle{$\approx$} 100, whereas in previous estimates [Rscr    ]G{$\approx$} 1, because for much of the time pairs of particles move together around vortical regions and only separate for the proportion of the time (of O(fc)) they spend in straining regions where streamlines diverge. It is estimated that [Rscr    ]G {$\approx$} O(fc-3). Thus relative diffusion is both a `structural' (or `topological') process as well as an intermittent inverse cascade process determined by increasing eddy scales as the particles separate; (f) statistics of large-scale turbulence are also computed, including the Lagrangian timescale, the pressure spectra and correlations, and these agree with predictions of Batchelor (1951), Hinzc (1975) and George et al. (1984).},
  langid = {english},
  file = {/home/mq/Zotero/storage/RF5IKT8G/Fung et al. - 1992 - Kinematic simulation of homogeneous turbulence by .pdf}
}

