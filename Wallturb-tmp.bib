@article{donzisDissipationEnstrophyIsotropic2008,
  title = {Dissipation and Enstrophy in Isotropic Turbulence: {{Resolution}} Effects and Scaling in Direct Numerical Simulations},
  shorttitle = {Dissipation and Enstrophy in Isotropic Turbulence},
  author = {Donzis, D. A. and Yeung, P. K. and Sreenivasan, K. R.},
