@article{liEffectReynoldsNumber2020,
  title = {Effect of {{Reynolds}} Number on Drag Reduction in Turbulent Boundary Layer Flow over Liquid--Gas Interface},
  author = {Li, Hongyuan (李宏源) and Ji, SongSong (姬松松) and Tan, Xiangkui (谭湘葵) and Li, Zexiang (李泽祥) and Xiang, Yaolei (相耀磊) and Lv, Pengyu (吕鹏宇) and Duan, Huiling (段慧玲)},
