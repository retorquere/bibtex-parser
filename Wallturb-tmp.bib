}

@inproceedings{arayaDIRECTNUMERICALSIMULATIONS2007,
  title = {{{DIRECT NUMERICAL SIMULATIONS OF A PASSIVE SCALAR IN A TURBULENT CHANNEL WITH LOCAL FORCING AT WALLS}}},
  booktitle = {Proceeding of {{Fifth International Symposium}} on {{Turbulence}} and {{Shear Flow Phenomena}}},
  author = {Araya, Guillermo and Leonardi, Stefano and Castillo, Luciano},
