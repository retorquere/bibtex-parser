  keywords = {dissipation,vegetation motion,wave-forcing},
  file = {/home/mq/Zotero/storage/TXPDQWSF/Mullarney and Henderson - 2010 - Wave-forced motion of submerged single-stem vegeta.pdf;/home/mq/Zotero/storage/EQWJ7PSV/2010JC006448.html}
}

@article{mullerbender-etal-2020,
