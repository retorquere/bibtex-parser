@misc{patelInfluenceNearwallDensity2016,
  title = {The Influence of Near-Wall Density and Viscosity Gradients on Turbulence in Channel Flows},
  author = {Patel, Ashish and Boersma, Bendiks Jan and Pecnik, Rene},
  year = 2016,
