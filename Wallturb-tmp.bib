  title = {Scalings and Structures in Turbulent {{Couette-Taylor}} Flow},
  author = {She, Zhen-Su and Ren, Kui and Lewis, Gregory S. and Swinney, Harry L.},
  year = 2001,
  month = jun,
  journal = {Physical Review E},
  volume = {64},
