@article{dungEmergenceBubbleinducedScaling2023,
  title = {The Emergence of Bubble-Induced Scaling in Thermal Spectra in Turbulence},
  author = {Dung, On-Yu and Waasdorp, Pim and Sun, Chao and Lohse, Detlef and Huisman, Sander G.},
  year = 2023,
  month = mar,
  journal = {Journal of Fluid Mechanics},
  volume = {958},
  pages = {A5},
  issn = {0022-1120, 1469-7645},
  doi = {10.1017/jfm.2023.66},
  urldate = {2024-09-12},
  abstract = {,  We report on the modification of the spectrum of a passive scalar inside a turbulent flow by the injection of large bubbles. Although the spectral modification through bubbles is well known and well analysed for the velocity fluctuations, little is known on how bubbles change the fluctuations of an approximately passive scalar, in our case temperature. Here we uncover the thermal spectral scaling behaviour of a turbulent multiphase thermal mixing layer. The development of a -3-3-3 spectral scaling is triggered. By injecting large bubbles ({$Rebub$}={$O$}(102)Rebub=O(102)\textbraceleft Re\textbraceright\_\textbraceleft\textbraceleft bub\textbraceright\textbraceright{} = \textbraceleft O\textbraceright (10\textasciicircum 2)) with gas volume fractions {$A\alpha\backslash$}alpha up to 5~\%. For these bubbly flows, the -5/3-5/3-5/3 scaling is still observed at intermediate frequencies for low {$A\alpha\backslash$}alpha but becomes less pronounced when {$A\alpha\backslash$}alpha further increases and it is followed by a steeper -3-3-3 slope for larger frequencies. This -3-3-3 scaling range extends with increasing gas volume fraction. The -3-3-3 scaling exponent coincides with the typical energy spectral scaling for the velocity fluctuations in high-Reynolds-number bubbly flows. We identify the frequency scale of the transition from the -5/3-5/3-5/3 scaling to the -3-3-3 scaling and show how it depends on the gas volume fraction.},
  langid = {english},
  keywords = {gas/liquid flow,turbulent mixing},
  file = {/home/mq/Zotero/storage/9EC6QCP5/Dung et al. - 2023 - The emergence of bubble-induced scaling in thermal.pdf}
}

