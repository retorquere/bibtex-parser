  keywords = {Altimetry,Circulation/ Dynamics,Eddies,Mesoscale processes,Observational techniques and algorithms},
  file = {/home/mq/Zotero/storage/HC5BUDBP/Zhou et al. - 2015 - Global Wavenumber Spectrum with Corrections for Al.pdf}
