@article{he-slunyaev-mori-2022,
  title = {Experimental {{Evidence}} of {{Nonlinear Focusing}} in {{Standing Water Waves}}},
  author = {He, Y. and Slunyaev, A. and Mori, N. and Chabchoub, A.},
