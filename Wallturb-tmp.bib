@article{ganapathisubramani-lakshminarasimhan-clemens-2007,
  title = {Determination of Complete Velocity Gradient Tensor by Using Cinematographic Stereoscopic {{PIV}} in a Turbulent Jet},
  author = {Ganapathisubramani, B. and Lakshminarasimhan, K. and Clemens, N. T.},
