@article{joshi-speyer-kim-1997,
  title = {A Systems Theory Approach to the Feedback Stabilization of Infinitesimal and Finite-Amplitude Disturbances in Plane {{Poiseuille}} Flow},
  author = {Joshi, S.S. and Speyer, J.L. and Kim, J.},
