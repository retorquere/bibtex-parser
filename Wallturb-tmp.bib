@article{mercadoBubbleClusteringEnergy2010,
  title = {On Bubble Clustering and Energy Spectra in Pseudo-Turbulence},
  author = {Mercado, Juli{\'a}n Mart{\'i}nez and G{\'o}mez, Daniel Chehata and Gils, Dennis Van and Sun, Chao and Lohse, Detlef},
