@article{marjoribanks-etal-2017,
  title = {Does the Canopy Mixing Layer Model Apply to Highly Flexible Aquatic Vegetation? {{Insights}} from Numerical Modelling},
  shorttitle = {Does the Canopy Mixing Layer Model Apply to Highly Flexible Aquatic Vegetation?},
  author = {Marjoribanks, T. I. and Hardy, R. J. and Lane, S. N. and Parsons, D. R.},
