  abstract = {,  We study the dynamics of capillary waves at the interface of a two-layer stratified turbulent channel flow. We use a combined pseudo-spectral/phase field method to solve for the turbulent flow in the two liquid layers and to track the dynamics of the liquid--liquid interface. The two liquid layers have same thickness and same density, but different viscosity. We vary the viscosity of the upper layer (two different values) to mimic a stratified oil--water flow. This allows us to study the interplay between inertial, viscous and surface tension forces in the absence of gravity. In the present set-up, waves are naturally forced by turbulence over a broad range of scales, from the larger scales, whose size is of order of the system scale, down to the smaller dissipative scales. After an initial transient, we observe the emergence of a stationary capillary wave regime, which we study by means of temporal and spatial spectra. The computed frequency and wavenumber power spectra of wave elevation are in line with previous experimental findings and can be explained in the frame of the weak wave turbulence theory. Finally, we show that the dispersion relation, which gives the frequency ({$\omega\omega\backslash$}omega) as a function of the wavenumber ({$k$}kk), is in good agreement with the well-established theoretical prediction, {$\omega$}({$k$}){$\simk$}3/2{$\omega$}(k){$\sim$}k3/2\textbackslash omega (k) \textbackslash sim k\textasciicircum\textbraceleft 3/2\textbraceright.},
  langid = {english},
  keywords = {capillary waves,stratified flows,wave-turbulence interactions},
  file = {/home/mq/Zotero/storage/P4QP3LJ5/Giamagas et al. - 2023 - Propagation of capillary waves in two-layer oil–wa.pdf}
}

@article{giamagas-etal-2023-2,
  title = {Turbulence and {{Interface Waves}} in {{Stratified Oil}}--{{Water Channel Flow}} at {{Large Viscosity Ratio}}},
  author = {Giamagas, G. and Zonta, F. and Roccon, A. and Soldati, A.},
  year = 2023,
  month = sep,
  journal = {Flow, Turbulence and Combustion},
  issn = {1573-1987},
  doi = {10.1007/s10494-023-00478-3},
  urldate = {2023-09-13},
  abstract = {We investigate the dynamics of turbulence and interfacial waves in an oil--water channel flow. We consider a stratified configuration, in which a thin layer of oil flows on top of a thick layer of water. The oil--water interface that separates the two layers mutually interacts with the surrounding flow field, and is characterized by the formation and propagation of interfacial waves. We perform direct numerical simulation of the Navier-Stokes equations coupled with a phase field method to describe the interface dynamics. For a given shear Reynolds number, \$\$Re\_\textbackslash tau =300\$\$, and Weber number, \$\$We=0.5\$\$, we consider three different types of oils, characterized by different viscosities, and thus different oil-to-water viscosity ratios \$\$\textbackslash mu \_r=\textbackslash mu \_o/\textbackslash mu \_w\$\$(being \$\$\textbackslash mu \_o\$\$and \$\$\textbackslash mu \_w\$\$oil and water viscosities). Starting from a matched viscosity case, \$\$\textbackslash mu \_r=1\$\$, we increase the oil-to-water viscosity ratio up to \$\$\textbackslash mu \_r=100\$\$. By increasing \$\$\textbackslash mu \_r\$\$, we observe significant changes both in turbulence and in the dynamics of the oil--water interface. In particular, the large viscosity of oil controls the flow regime in the thin oil layer, as well as the turbulence activity in the thick water layer, with direct consequences on the overall channel flow rate,~which decreases when the oil viscosity is increased. Correspondingly, we observe remarkable changes in the dynamics of waves that propagate at the oil--water interface. In particular, increasing the viscosity ratio from \$\$\textbackslash mu \_r=1\$\$to \$\$\textbackslash mu \_r=100\$\$, waves change from a two-dimensional, nearly-isotropic pattern, to an almost monochromatic one.},
  langid = {english},
  keywords = {Deformable interface,Direct numerical simulation,Multiphase flow,Phase field method,Turbulence},
  file = {/home/mq/Zotero/storage/S2KSDDAR/Giamagas et al. - 2023 - Turbulence and Interface Waves in Stratified Oil–W.pdf}
}

