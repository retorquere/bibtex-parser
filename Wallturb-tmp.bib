@article{batchelor-1959,
  title = {Small-Scale Variation of Convected Quantities like Temperature in Turbulent Fluid {{Part}} 1. {{General}} Discussion and the Case of Small Conductivity},
  author = {Batchelor, G. K.},
  year = 1959,
  month = jan,
  journal = {Journal of Fluid Mechanics},
  volume = {5},
  number = {1},
  pages = {113--133},
  issn = {1469-7645, 0022-1120},
  doi = {10.1017/S002211205900009X},
  urldate = {2024-06-21},
  abstract = {When some external agency imposes on a fluid large-scale variations of some dynamically passive, conserved, scalar quantity \texttheta{} like temperature or concentration of solute, turbulent motion of the fluid generates small-scale variations of \texttheta. This paper describes a theoretical investigation of the form of the spectrum of \texttheta{} at large wave-numbers, taking into account the two effects of convection with the fluid and molecular diffusion with diffusivity k. Hypotheses of the kind made by Kolmogoroff for the small-scale variations of velocity in a turbulent motion at high Reynolds number are assumed to apply also to small-scale variations of \texttheta.Previous contributions to the problem are reviewed. These have established that the spectrum of \texttheta{} varies as \$ n\textasciicircum\textbraceleft - \textbackslash frac \textbraceleft 5\textbraceright{} \textbraceleft 3\textbraceright\textbraceright\$ (n being wave-number) at the low wave-number end of the equilibrium range, but there has been some confusion about the wave-number marking the upper end of the range of validity of this relation. The existence of a conduction `cut-off' near \$ n = \textbackslash isin\textbraceleft\textbackslash sol\textbraceright k \textbraceleft\textasciicircum 3\textbraceright ) \textbraceleft\textasciicircum\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$ as put forward by Obukhoff and Corrsin is shown to hold only when {$\nu$} [Lt      ] {$\kappa$}, and that near n = ({$\varepsilon$}/{$\nu\kappa$}2) \$ \textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$ put forward by Batchelor is shown to apply only when {$\nu$} [Gt      ] {$\kappa$}. In the case {$\nu$} [Lt      ] {$\kappa$}, the remaining problem is to determine the form of the spectrum of \texttheta{} beyond the conduction cut-off; this is done in Part 2. In the case {$\nu$} [Gt      ] {$\kappa$}, the conduction cut-off occurs at wave-numbers much higher than ({$\varepsilon$}/{$\nu$}3)\$ \textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$, which is where the energy spectrum is cut off by viscosity, and where the spectrum of \texttheta{} ceases to vary as \$ n\textasciicircum\textbraceleft - \textbackslash frac \textbraceleft 5\textbraceright{} \textbraceleft 3\textbraceright\textbraceright\$.The form of the spectrum of \texttheta{} in this latter case is determined over the range n {$>$} ({$\varepsilon$}/{$\nu$}3)\$ \textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$ by analysing the effect of the velocity field, regarded as effectively a persistent uniform straining motion for these small-scale variations of \texttheta, and of molecular diffusion on a single Fourier component of \texttheta. The wave-number of this sinusoidal variation of \texttheta{} is changed (and generally increased in magnitude) by the straining motion and the amplitude is diminished by diffusion. By supposing that the level of the spectrum of \texttheta{} is kept steady at wave-numbers near ({$\varepsilon$}/{$\nu$}3)\$ \textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$ by some mechanism of transfer from lower wave-numbers, the linearity of the equation for \texttheta{} then allows the determination of the spectrum for n {$>$} ({$\varepsilon$}/{$\nu$}3) \$ \textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright{} \textbraceleft 4\textbraceright\textbraceright\$, the result being given by (4.8). The same result is obtained, using essentially the same approximation about the velocity field, from a different kind of analysis in terms of velocity and \texttheta{} correlations. Finally, the relation between this work and Townsend's model of the small-scale variations of vorticity in a turbulent fluid is discussed.},
  langid = {english},
  file = {/home/mq/Zotero/storage/N8H8FTJD/Batchelor - 1959 - Small-scale variation of convected quantities like.pdf}
}

