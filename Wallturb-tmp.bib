@article{deshpande-etal-2023c,
  title = {On the Relationship between Manipulated Inter-Scale Phase and Energy-Efficient Turbulent Drag Reduction},
  author = {Deshpande, R. and Chandran, D. and Smits, A. J. and Marusic, I.},
  year = 2023,
