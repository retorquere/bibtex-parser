@article{tanaka-eaton-2010,
  title = {Sub-{{Kolmogorov}} Resolution Partical Image Velocimetry Measurements of Particle-Laden Forced Turbulence},
  author = {Tanaka, Tomohiko and Eaton, John K.},
  year = 2010,
