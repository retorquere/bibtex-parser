@article{shahmardi-etal-2021,
  title = {A Fully {{Eulerian}} Hybrid Immersed Boundary-Phase Field Model for Contact Line Dynamics on Complex Geometries},
  author = {Shahmardi, Armin and Rosti, Marco Edoardo and Tammisola, Outi and Brandt, Luca},
  year = 2021,
  month = oct,
  journal = {Journal of Computational Physics},
  volume = {443},
