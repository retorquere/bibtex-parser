@article{selaSemiimplicitDirectForcing2021,
  title = {A Semi-Implicit Direct Forcing Immersed Boundary Method for Periodically Moving Immersed Bodies: {{A Schur}} Complement Approach},
  shorttitle = {A Semi-Implicit Direct Forcing Immersed Boundary Method for Periodically Moving Immersed Bodies},
  author = {Sela, Rafi and Zemach, Efi and Feldman, Yuri},
  year = 2021,
