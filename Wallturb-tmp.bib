@article{zhang-etal-2014,
  title = {A Generalized {{Reynolds}} Analogy for Compressible Wall-Bounded Turbulent Flows},
  author = {Zhang, Y.-S. and Bi, W.-T. and Hussain, F. and She, Z.-S.},
