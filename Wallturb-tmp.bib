  year = 2025,
  month = jun,
  number = {arXiv:2506.22239},
  eprint = {2506.22239},
  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2506.22239},
  urldate = {2025-07-01},
  abstract = {The description of riblets and other drag-reducing devices has long used the concept of longitudinal and transverse protrusion heights, both as a means to predict the drag reduction itself and as equivalent boundary conditions to simplify numerical simulations by transferring the effect of riblets onto a flat virtual boundary. The limitation of this idea is that it stems from a first-order approximation in the riblet-size parameter \$s\textasciicircum +\$, and as a consequence it cannot predict other than a linear dependence of drag reduction upon \$s\textasciicircum +\$; in other words, the initial slope of the drag-reduction curve. Here the concept is extended to a full asymptotic expansion using matched asymptotics, which consistently provides higher-order protrusion heights and higher-order equivalent boundary conditions on a virtual flat surface. This procedure also allows us to explore nonlinearities of the Navier-Stokes equations and the way they enter the \$s\textasciicircum +\$-expansion, with somewhat surprising results.},
  archiveprefix = {arXiv},
  keywords = {Physics - Fluid Dynamics},
  file = {/home/mq/Zotero/storage/9RZQ56NV/Luchini and Chung - 2025 - Higher-order homogenised riblet boundary condition.pdf;/home/mq/Zotero/storage/CJVNQXY9/2506.html}
