@article{davey-1962,
  title = {The Growth of {{Taylor}} Vortices in Flow between Rotating Cylinders},
  author = {Davey, A.},
  year = 1962,
  month = nov,
  journal = {Journal of Fluid Mechanics},
  volume = {14},
  number = {3},
