@article{orlandi-modesti-pirozzoli-2018,
  title = {{{DNS}} of {{Turbulent Flows}} in {{Ducts}} with {{Complex Shape}}},
  author = {Orlandi, Paolo and Modesti, Davide and Pirozzoli, Sergio},
  year = 2018,
