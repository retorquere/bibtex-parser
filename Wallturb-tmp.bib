@article{sullivan-etal-2000,
  title = {Simulation of Turbulent Flow over Idealized Water Waves},
  author = {Sullivan, P. P. and McWILLIAMS, J. C. and Moeng, C. H.},
  year = 2000,
  month = feb,
  journal = {Journal of Fluid Mechanics},
  volume = {404},
