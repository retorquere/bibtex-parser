  urldate = {2023-05-02},
  abstract = {To date, flow through submerged aquatic vegetation has largely been viewed as perturbed boundary layer flow, with vegetative drag treated as an extension of bed drag. However, recent studies of terrestrial canopies demonstrate that the flow structure within and just above an unconfined canopy more strongly resembles a mixing layer than a boundary layer. This paper presents laboratory measurements, obtained from a scaled seagrass model, that demonstrate the applicability of the mixing layer analogy to aquatic systems. Specifically, all vertical profiles of mean velocity contained an inflection point, which makes the flow susceptible to Kelvin-Helmholtz instability. This instability leads to the generation of large, coherent vortices within the mixing layer (observed in the model at frequencies between 0.01 and 0.11 Hz), which dominate the vertical transport of momentum through the layer. The downstream advection of these vortices is shown to cause the progressive, coherent waving of aquatic vegetation, known as the monami. When the monami is present, the turbulent vertical transport of momentum is enhanced, with turbulent stresses penetrating an additional 30\% of the plant height into the canopy.},
  langid = {english},
  keywords = {mixing layer,monami,seagrass,turbulence,vegetated flow,vortices},
  file = {/home/mq/Zotero/storage/GK97JZEN/Ghisalberti and Nepf - 2002 - Mixing layers and coherent structures in vegetated.pdf;/home/mq/Zotero/storage/HSS2T28C/2001JC000871.html}
}

