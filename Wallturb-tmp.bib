@misc{larssenSpatiotemporalFluctuationsInterscale2023,
  title = {Spatio-Temporal Fluctuations of Interscale and Interspace Energy Transfer Dynamics in Homogeneous Turbulence},
  author = {Larssen, H. S. and Vassilicos, J. C.},
  year = 2023,
  month = apr,
  number = {arXiv:2304.05479},
