@article{lenain-etal-2022,
  title = {A {{Broadband View}} of the {{Sea Surface Height Wavenumber Spectrum}}},
  author = {Villas B{\^o}as, A. B. and Lenain, L. and Cornuelle, Bruce D. and Gille, S. T. and Mazloff, M. R.},
