@article{wursterDeepHierarchicalSuperResolution2021,
  title = {Deep {{Hierarchical Super-Resolution}} for {{Scientific Data Reduction}} and {{Visualization}}},
  author = {Wurster, Skylar W. and Shen, Han-Wei and Guo, Hanqi and Peterka, Thomas and Raj, Mukund and Xu, Jiayi},
  year = 2021,
