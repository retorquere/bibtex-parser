@article{auteri-parolini-quartapelle-2003,
  title = {Essential Imposition of {{Neumann}} Condition in {{Galerkin}}--{{Legendre}} Elliptic Solvers},
  author = {Auteri, F. and Parolini, N. and Quartapelle, L.},
  year = 2003,
