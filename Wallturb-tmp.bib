@article{xieThirdorderStructureFunction2021,
  title = {Third-Order Structure Function in the Logarithmic Layer of Boundary-Layer Turbulence},
  author = {Xie, Jin-Han and {de Silva}, Charitha and Baidya, Rio and Yang, Xiang IA and Hu, Ruifeng},
