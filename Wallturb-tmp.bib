@article{chengSkinfrictionReductionUsing2021,
  title = {Skin-Friction Reduction Using Periodic Blowing through Streamwise Slits},
  author = {Cheng, X. Q. and Qiao, Z. X. and Zhang, X. and Quadrio, M. and Zhou, Y.},
