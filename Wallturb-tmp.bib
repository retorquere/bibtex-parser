  keywords = {turbulence theory,turbulent boundary layers,turbulent flows},
  file = {/home/mq/Zotero/storage/C537H46G/Pirozzoli - 2014 - Revisiting the mixing-length hypothesis in the out.pdf}
}

@article{pirozzoli-2023,
  title = {Searching for the Log Law in Open Channel Flow},
  author = {Pirozzoli, S.},
