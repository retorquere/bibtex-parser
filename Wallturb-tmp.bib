@article{fornariEffectParticleDensity2016,
  title = {The Effect of Particle Density in Turbulent Channel Flow Laden with Finite Size Particles in Semi-Dilute Conditions},
  author = {Fornari, W. and Formenti, A. and Picano, F. and Brandt, L.},
  year = 2016,
