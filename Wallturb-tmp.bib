@article{gageik-klioutchn-olivier-2015,
  title = {Comprehensive Mesh Study for a {{Direct Numerical Simulation}} of the Transonic Flow at {{Rec}} = 500,000 around a {{NACA}} 0012 Airfoil},
  author = {Gageik, M. and Klioutchnikov, I. and Olivier, H.},
