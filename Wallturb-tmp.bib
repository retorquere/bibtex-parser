@article{pena-etal-2022,
  title = {Intense Upper Ocean Mixing Due to Large Aggregations of Spawning Fish},
  author = {Fern{\'a}ndez Castro, B. and Pe{\~n}a, M. and Nogueira, E. and Gilcoto, M. and Broull{\'o}n, E. and Comesa{\~n}a, A. and Bouffard, D. and Naveira Garabato, A. and {Mouri{\~n}o-Carballido}, B.},
  year = 2022,
