@article{leclercq-delangre-2018,
  title = {Reconfiguration of Elastic Blades in Oscillatory Flow},
  author = {Leclercq, T. and De Langre, E.},
  year = 2018,
  month = mar,
  journal = {Journal of Fluid Mechanics},
  volume = {838},
