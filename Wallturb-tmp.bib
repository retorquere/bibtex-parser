@article{suzuki-hasegawa-2017,
  title = {Estimation of Turbulent Channel Flow at {{Retau}}=100 Based on the Wall Measurement Using a Simple Sequential Approach},
  author = {Suzuki, T. and Hasegawa, Y.},
  year = 2017,
