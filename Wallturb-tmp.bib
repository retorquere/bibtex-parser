@article{maulik-etal-2019a,
  title = {Subgrid Modelling for Two-Dimensional Turbulence Using Neural Networks},
  author = {Maulik, R. and San, O. and Rasheed, A. and Vedula, P.},
  year = 2019,
  month = jan,
  journal = {Journal of Fluid Mechanics},
  volume = {858},
