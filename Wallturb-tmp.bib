@article{wakimVortexPairGround2020,
  title = {A Vortex Pair in Ground Effect, Dynamics and Optimal Control},
  author = {Wakim, Arnold and Brion, Vincent and {Dolfi-Bouteyre}, Agn{\`e}s and Jacquin, Laurent},
  year = 2020,
