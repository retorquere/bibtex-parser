@article{kankanwadi-buxton-2020,
  title = {Turbulent Entrainment into a Cylinder Wake from a Turbulent Background},
  author = {Kankanwadi, Krishna S. and Buxton, Oliver R. H.},
  year = 2020,
  month = dec,
  journal = {Journal of Fluid Mechanics},
  volume = {905},
