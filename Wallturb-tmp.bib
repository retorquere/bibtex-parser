@article{lohrer-frohlich-2025,
  title = {Large-Eddy Simulation of the Fluid--Structure Interaction in Aquatic Canopies Consisting of Highly Flexible Blades},
  author = {L{\"o}hrer, B. and Fr{\"o}hlich, J.},
  year = 2025,
