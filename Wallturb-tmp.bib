@article{gomez-2025,
  title = {Direct Numerical Simulations of Supersonic Three-Dimensional Turbulent Boundary Layers},
  author = {Gomez, Salvador Rey},
  year = 2025,
  month = nov,
  journal = {Journal of Fluid Mechanics},
  volume = {1022},
