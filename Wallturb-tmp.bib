@article{sadeghi-etal-2016,
  title = {Scale-by-Scale Budget Equation and Its Self-Preservation in the Shear-Layer of a Free Round Jet},
  author = {Sadeghi, Hamed and Lavoie, Philippe and Pollard, Andrew},
  year = 2016,
  month = oct,
  journal = {International Journal of Heat and Fluid Flow},
  series = {{{SI}}\textbackslash :{{TSFP9}} Special Issue},
  volume = {61},
