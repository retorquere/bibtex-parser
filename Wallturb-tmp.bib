@article{landerInfluenceBluffBody2016,
  title = {Influence of the Bluff Body Shear Layers on the Wake of a Square Prism in a Turbulent Flow},
  author = {Lander, D. C. and Letchford, C. W. and Amitay, M. and Kopp, G. A.},
