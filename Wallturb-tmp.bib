  doi = {10.1017/jfm.2019.739},
  urldate = {2024-07-01},
  abstract = {The work presents an experimental investigation into the motion of and hydrodynamic forces along a single flexible stem in regular waves. The experiment covers a large range in relevant non-dimensional parameters: the drag-to-stiffness ratio {$CaL\in$}[0.003,3.8]CaL{$\in$}[0.003,3.8]CaL\textbackslash in [0.003,3.8], the inertia-to-stiffness ratio {$CaL$}/{$KC\in$}[4\texttimes 10-5,14.8]CaL/KC{$\in$}[4\texttimes 10-5,14.8]CaL/KC\textbackslash in [4\textbackslash times 10\textasciicircum\textbraceleft -5\textbraceright,14.8], the Keulegan--Carpenter number {$KC\in$}[3.8,145]KC{$\in$}[3.8,145]KC\textbackslash in [3.8,145] and the Reynolds number {$Re\in$}[230,2900]Re{$\in$}[230,2900]Re\textbackslash in [230,2900]. The two first parameters relate to the response of the stem in waves and thus account for material properties, while the two last parameters are relevant for hydrodynamic forces on the stem. The displacement of the stem was captured with a digital video camera and the displacement along the stem was captured for every 2.5~mm at 25~Hz. This unique laboratory data set allowed for the following analyses: (i)~Determination of the relevant non-dimensional parameter to predict the stem motion and shape. (ii)~A direct comparison between the measured force for mimics of two lengths (0.15~m and 0.30~m) illustrating the force reduction potential for flexible mimics. (iii)~Direct evaluation of the average force coefficients {$CD$}CDC\_\textbraceleft D\textbraceright{} (drag) and {$CM$}CMC\_\textbraceleft M\textbraceright{} (inertia) for the flexible stems. (iv)~The distributed external hydrodynamic loading and the internal shear forces were estimated from the laboratory experiments. The distribution of the shear force helped to understand the breakage mechanisms of flexible stems. (v) A linkage between phase lags and internal shear forces was suggested. The data set is considered valuable as validation material for numerical models of stem motion in waves.},
  langid = {english},
  keywords = {coastal engineering,wave-structure interactions},
  file = {/home/mq/Zotero/storage/88TLZK7I/Jacobsen et al. - 2019 - Experimental investigation of the wave-induced mot.pdf}
