@article{mollicone-etal-2022,
  title = {Superhydrophobic Surfaces Reduce Form Drag in Separated Flows},
  author = {Mollicone, J.-P. and Battista, F. and Gualtieri, P. and Casciola, C. M.},
  year = 2022,
  month = feb,
  journal = {arXiv:2202.11407 [physics]},
  eprint = {2202.11407},
  primaryclass = {physics},
  urldate = {2022-03-14},
  abstract = {The drag force acting on a body moving in a fluid has two components, friction drag due to fluid viscosity and form drag due to flow separation behind the body. When present, form drag is the most significant between the two. In many applications, streamlining effectively prevents flow separation, fast vehicle aerodynamics being the archetypal example. As shown here, when the operating fluid is water, e.g. for large container ships or underwater vehicles, a promising technique is to decorate the walls of the body with superhydrophobic surfaces. These surfaces entrap gas bubbles in their asperities, avoiding the direct contact of the liquid with the wall. Superhydrophobic surfaces have been largely studied for reducing friction drag. Rather unexpectedly, they are shown here to be also extremely effective in reducing/preventing flow separation, thereby reducing the form drag. Their conceptual effectiveness is demonstrated by exploiting numerical simulations of turbulent flows over a bluff obstacle fixed over a wall. The approach envisaged here could pave the way to new and powerful techniques for drag reduction on large bluff bodies moving in the water.},
  archiveprefix = {arXiv},
  keywords = {Physics - Fluid Dynamics},
  file = {/home/mq/Zotero/storage/6XDSBWMD/Mollicone et al. - 2022 - Superhydrophobic surfaces reduce form drag in sepa.pdf}
}

@article{moltchanov-etal-2015,
  title = {Canopy Edge Flow: {{A}} Momentum Balance Analysis},
  shorttitle = {Canopy Edge Flow},
  author = {Moltchanov, S. and {Bohbot-Raviv}, Y. and Duman, T. and Shavit, U.},
  year = 2015,
  journal = {Water Resources Research},
  volume = {51},
  number = {4},
  pages = {2081--2095},
  issn = {1944-7973},
  doi = {10.1002/2014WR015397},
  urldate = {2025-02-26},
  abstract = {Canopy flow models are often dedicated to ideal, infinite, homogenous systems. However, real canopy systems have physical boundaries, where the flow enters and leaves patches of vegetation, generating a complex pressure field and velocity variations. Here we focus our study on the canopy entry region by examining the terms involved in the double (space and time) averaged momentum equations and their relative contribution to the total momentum balance. The estimation of each term is made possible by particle image velocimetry (PIV) measurements in a model canopy constructed of randomly distributed thin glass plates. The instantaneous velocity fields were used to calculate the mean velocities, pressure, drag, Reynolds stresses, and dispersive stresses. It was found that within the entry region, the pressure gradient, the drag forces, and dispersive stresses are the three most significant terms that affect the balance in the streamwise momentum equation. In the vertical direction, the dispersive stresses are also significant and their contribution to the total momentum cannot be ignored. The study shows that dispersive stresses are initially formed around canopy edges; at both the entry region and the canopy top boundary. They start as a sink term, extracting momentum from the flow, and then become a source term that contributes momentum to the flow until they eventually decay at some short penetration distance into the canopy. These results reveal a new understanding on the evolution of momentum within the entry region, necessary in any closure modeling of flow in real canopies.},
  copyright = {\copyright{} 2015. American Geophysical Union. All Rights Reserved.},
  langid = {english},
  keywords = {canopy edge,canopy flow,dispersive stress,particle image velocimetry (PIV)},
  file = {/home/mq/Zotero/storage/F2TXWBZJ/Moltchanov et al. - 2015 - Canopy edge flow A momentum balance analysis.pdf;/home/mq/Zotero/storage/UP5Z7XR2/2014WR015397.html}
}

