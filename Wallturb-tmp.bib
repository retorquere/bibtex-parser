}

@article{cavaiola-mazzini-2021,
  title = {Self-Propelled Slender Objects Can Measure Flow Signals Net of Self-Motion},
  author = {Cavaiola, M. and Mazzino, A.},
  year = 2021,
  month = may,
  journal = {Physics of Fluids},
