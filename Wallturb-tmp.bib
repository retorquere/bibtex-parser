  langid = {english},
  keywords = {Humanities and Social Sciences,multidisciplinary,Science},
  file = {/home/mq/Zotero/storage/HYAH83PG/Alben et al. - 2002 - Drag reduction through self-similar bending of a f.pdf}
}

