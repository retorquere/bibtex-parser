@article{benavides-etal-2022,
  title = {Inverse Cascade Suppression and Shear-Layer Formation in Magnetohydrodynamic Turbulence Subject to a Guide Field and Misaligned Rotation},
  author = {Benavides, Santiago J. and Burns, Keaton J. and Gallet, Basile and Cho, James Y-K. and Flierl, Glenn R.},
  year = 2022,
