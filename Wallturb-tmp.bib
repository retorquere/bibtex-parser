@article{gaoDragModulationInertial2024,
  title = {Drag Modulation by Inertial Particles in a Drag-Reduced Turbulent Channel Flow with Spanwise Wall Oscillation},
  author = {Gao, Wei (高伟) and Wang, Minmiao (王敏妙) and Parsani, Matteo},
