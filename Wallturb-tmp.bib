}

@article{rubol-ling-battiato-2018,
  title = {Universal Scaling-Law for Flow Resistance over Canopies with Complex Morphology},
  author = {Rubol, S. and Ling, B. and Battiato, I.},
  year = 2018,
  month = mar,
  journal = {Scientific Reports},
  volume = {8},
