@article{jeganathan-alba-ostillamonico-2021,
  title = {Controlling Secondary Flows in {{Taylor}}--{{Couette}} Flow Using Stress-Free Boundary Conditions},
  author = {Jeganathan, V. and Alba, K. and {Ostilla-M{\'o}nico}, R.},
  year = 2021,
