@misc{liIncorporatingBasicCalibrations2023,
  title = {Incorporating Basic Calibrations in Existing Machine-Learned Turbulence Modeling},
  author = {Li, Jiaqi J. L. and Bin, Yuanwei and Huang, George P. and Yang, Xiang I. A.},
  year = 2023,
  month = nov,
  number = {arXiv:2311.03133},
  eprint = {2311.03133},
  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2311.03133},
  urldate = {2023-11-10},
  abstract = {Machine-learning (ML) models lack the generalizability exhibited by conventional empirical models. This limitation arises from the fact that ML models do not preserve the fundamental calibrations that make up a turbulent flow. Among these calibrations, the law of the wall (LoW) holds particular importance. This study aims to address this issue by incorporating LoW in existing machine-learning frameworks. If successful, this will significantly increase the generalizability of ML models. We focus on three well-established machine-learning frameworks: tensor-basis neural networks (TBNN), physics-informed machine learning (PIML), and field inversion \textbackslash\& machine learning (FIML). Baseline models include the one-equation Spalart-Allmaras model, the two-equation Wilcox \$k\$-\$\textbackslash omega\$ model, and the seven-equation full Reynolds stress model. TBNN yields augmentations that prove to be detrimental at both the training and testing conditions. PIML yields augmentations that lead to improvements in the training set but are detrimental outside. These results do not depend on the baseline model. FIML's augmentations are mostly neutral towards the one- and two-equation models and improve the seven-equation models. The flow is sufficiently simple, and a physics-based interpretation is possible. Analysis shows that TBNN and PIML are detrimental because of the choice of inputs. FIML yields neutral augmentation because it ``recognizes'' that the one- and two-equation models here capture the LoW. Last, FIML's augmentation to the seven-equation model is a general treatment of the entire profile which, despite being an improvement, is unphysical. In all, this work discusses the reason why ML models lack generalizability and enhances the generalizability through the incorporation of LoW.},
  archiveprefix = {arXiv},
  keywords = {Physics - Fluid Dynamics},
  file = {/home/mq/Zotero/storage/LA25R8VY/Li et al. - 2023 - Incorporating basic calibrations in existing machi.pdf}
}

