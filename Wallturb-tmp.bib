  file = {/home/mq/Zotero/storage/QMFP7LIW/S0021999112000423.html}
}

@article{kenjeresRecentProgressModelling2016,
  title = {On {{Recent Progress}} in {{Modelling}} and {{Simulations}} of {{Multi-scale Transfer}} of {{Mass}}, {{Momentum}} and {{Particles}} in {{Bio-medical Applications}}},
