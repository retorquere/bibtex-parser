@article{dong-etal-2017,
  title = {Coherent Structures in Statistically Stationary Homogeneous Shear Turbulence},
  author = {Dong, Siwei and {Lozano-Dur{\'a}n}, Adri{\'a}n and Sekimoto, Atsushi and Jim{\'e}nez, Javier},
  year = 2017,
