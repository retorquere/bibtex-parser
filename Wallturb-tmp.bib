}

@article{krochak-etal-2010,
  title = {Near-Wall Estimates of the Concentration and Orientation Distribution of a Semi-Dilute Rigid Fibre Suspension in {{Poiseuille}} Flow},
  author = {Krochak, P. J. and Olson, J. A. and Martinez, D. M.},
