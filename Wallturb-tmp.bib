@article{kevinMeanderingBehaviourLargescale2019,
  ids = {kevin-monty-hutchins-2019},
  title = {The Meandering Behaviour of Large-Scale Structures in Turbulent Boundary Layers},
  author = {Kevin, Kevin and Monty, Jason and Hutchins, Nicholas},
