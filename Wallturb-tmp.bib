@article{song-etal-2024,
  title = {Numerical Investigation of a Three-Dimensional Flow Structure Influenced by the Lateral Expansion of a Partially Distributed Submerged Canopy},
  author = {Song, S. Y. and Wang, X. K. and Duan, H. F. and Stocchino, A. and Yan, X. F.},
