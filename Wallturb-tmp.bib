@inproceedings{luchini-2018-c,
  title = {Law of the {{Wall}} and {{Law}} of the {{Wake}} in {{Turbulent Parallel Flow}}},
  booktitle = {Progress in {{Turbulence VIII}}},
  author = {Luchini, Paolo},
