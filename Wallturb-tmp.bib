  doi = {10.1103/PhysRevLett.72.336},
  urldate = {2023-02-24},
  abstract = {The inertial-range scaling laws of fully developed turbulence are described in terms of scalings of a sequence of moment ratios of the energy dissipation field {$\varepsilon$}l coarse-grained at inertial-range scale l. These moment ratios {$\varepsilon$}(p)l=\textlangle{$\varepsilon$}p+1l\textrangle/\textlangle{$\varepsilon$}pl\textrangle (p=0, 1, 2,...,) form a hierarchy of structures. The most singular structures {$\varepsilon$}({$\infty$})l are assumed to be filaments, and it is argued that {$\varepsilon$}({$\infty$})l{$\sim$}l-2/3. Furthermore, a universal relation between scalings of successive structures is postulated, which leads to a prediction of the entire set of the scaling exponents: \textlangle{$\varepsilon$}pl\textrangle{$\sim$}l{$\tau$}p, {$\tau$}p=-2/3p+2[1-( 2) / 3 )p] and \textlangle{$\delta$}vpl\textrangle{$\sim$}l{$\zeta$}p, {$\zeta$}p=p/9+2[1-(2/3)p/3].},
  file = {/home/mq/Zotero/storage/BVMV3347/She and Leveque - 1994 - Universal scaling laws in fully developed turbulen.pdf;/home/mq/Zotero/storage/FLR5SUYQ/PhysRevLett.72.html}
}

