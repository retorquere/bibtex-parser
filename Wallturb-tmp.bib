  title = {Modal and Non-Modal Stability Analysis of Electrohydrodynamic Flow with and without Cross-Flow},
  author = {Zhang, Mengqi and Martinelli, Fulvio and Wu, Jian and Schmid, Peter J. and Quadrio, Maurizio},
