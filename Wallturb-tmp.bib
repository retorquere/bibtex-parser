  urldate = {2022-07-02},
  abstract = {, Wake transitions behind an isolated cube are investigated numerically over a range of Reynolds number (ReRe\textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright ) 1--400. Four flow regimes, namely the orthogonal symmetry--steady (1{$\leq$}Re{$\leq$}2051{$\leq$}Re{$\leq$}2051 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 205), planar symmetry--steady (PSS, 210{$\leq$}Re{$\leq$}250210{$\leq$}Re{$\leq$}250210 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 250), hairpin-vortex shedding (HS, 255{$\leq$}Re{$\leq$}305255{$\leq$}Re{$\leq$}305255 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 305) and chaotic vortex shedding (Re{$\geq$}310Re{$\geq$}310\textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash ge 310) regimes, are identified according to spatial symmetries and temporal development of the flow. A weakly nonlinear stability analysis, through a coupled pitchfork bifurcation model proposed in the present study, reveals that the bifurcation to the PSS regime is supercritical and the planar symmetry is retained in the PSS regime because stable points (four) exist only on the two symmetry planes perpendicular to the side faces of the cube. The supercritical Hopf bifurcation to the HS regime is induced by the excessive accumulation of circulation in the downstream tips of merged streamwise vortex tubes behind the cube that subsequently attract the vortex tubes of opposite signs to cut the tips off from them, leading to alternate shedding of streamwise vortex tubes. The planar symmetry observed in the PSS regime is preserved in the three vortex shedding states identified in the HS regime, i.e. single-frequency shedding (255{$\leq$}Re{$\leq$}280255{$\leq$}Re{$\leq$}280255 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 280), quasi-periodic shedding (282{$\leq$}Re{$\leq$}285282{$\leq$}Re{$\leq$}285282 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 285) and the high-order synchronised shedding (HS2, 289{$\leq$}Re{$\leq$}305289{$\leq$}Re{$\leq$}305289 \textbackslash le \textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash le 305). A cascade of period doubling and period halving is discovered in the HS2 state, prior to the flow bifurcation to the chaotic vortex shedding regime, where the planar symmetry is broken. The critical ReRe\textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} values for the bifurcations to PSS and HS regimes are estimated to be Re{$\approx$}207.0Re{$\approx$}207.0\textbraceleft\textbraceleft\textbackslash textit \textbraceleft Re\textbraceright\textbraceright\textbraceright{} \textbackslash approx 207.0 and 252.0, respectively, through linear interpolation of the growth rate of flow instabilities.},
  langid = {english},
  keywords = {bifurcation,flow-structure interactions,vortex shedding},
  file = {/home/mq/Zotero/storage/RXB2PHZM/Meng et al. - 2021 - Wake transitions behind a cube at low and moderate.pdf;/home/mq/Zotero/storage/UNSHGWGV/Meng-etal-2021.pdf;/home/mq/Zotero/storage/ITESYE4J/F07F6DE7D17E83AC6F24CE9069B6DF37.html}
}

@article{mensa-etal-2015,
  title = {Material Transport in a Convective Surface Mixed Layer under Weak Wind Forcing},
  author = {Mensa, J. A. and {\"O}zg{\"o}kmen, T. M. and Poje, A. C. and Imberger, J.},
  year = 2015,
  journal = {Ocean Modelling},
  volume = {96},
  pages = {226--242},
  issn = {14635003},
  doi = {10.1016/j.ocemod.2015.10.006},
  urldate = {2022-03-25},
  abstract = {Flows in the upper ocean mixed layer are responsible for the transport and dispersion of biogeochemical tracers, phytoplankton and buoyant pollutants, such as hydrocarbons from an oil spill. Material dispersion in mixed layer flows subject to diurnal buoyancy forcing and weak winds (\textbar u10\textbar{} = 5 m s-1) are investigated using a non-hydrostatic model. Both purely buoyancy-forced and combined wind- and buoyancy-forced flows are sampled using passive tracers, as well as 2D and 3D particles to explore characteristics of horizontal and vertical dispersion. It is found that the surface tracer patterns are determined by the convergence zones created by convection cells within a time scale of just a few hours. For pure convection, the results displayed the classic signature of Rayleigh--Benard cells. When combined with a wind stress, the convective cells become anisotropic in that the along-wind length scale gets much larger than the cross-wind scale. Horizontal relative dispersion computed by sampling the flow fields using both 2D and 3D passive particles is found to be consistent with the Richardson regime. Relative dispersion is an order of magnitude higher and 2D surface releases transition to Richardson regime faster in the wind-forced case. We also show that the buoyancy-forced case results in significantly lower amplitudes of scale-dependent horizontal relative diffusivity, kD( ), than those reported by Okubo (1970), while the wind- and buoyancy-forced case shows a good agreement with Okubo's diffusivity amplitude, and the scaling is consistent with Richardson's 4/3rd law, kD {$\sim$} 4/3. These modeling results provide a framework for measuring material dispersion by mixed layer flows in future observational programs.},
  langid = {english},
  keywords = {Relative dispersion,Scale-dependent diffusivity,Upper ocean turbulence},
  file = {/home/mq/Zotero/storage/5QJCLHM4/Mensa et al. - 2015 - Material transport in a convective surface mixed l.pdf;/home/mq/Zotero/storage/9XA7I3EW/S1463500315002097.html}
}

