}

@article{loiseau-etal-2020,
  title = {Active Mucus--Cilia Hydrodynamic Coupling Drives Self-Organization of Human Bronchial Epithelium},
  author = {Loiseau, E. and Gsell, S. and Nommick, A. and Jomard, C. and Gras, D. and Chanez, Pascal and D'Ortona, Umberto and Kodjabachian, Laurent and Favier, Julien and Viallat, Annie},
  year = 2020,
  journal = {Nature Physics},
