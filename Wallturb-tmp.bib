  pages = {287--306},
  issn = {1469-7645, 0022-1120},
  doi = {10.1017/S0022112009993570},
  urldate = {2024-09-12},
  abstract = {Three-dimensional particle tracking velocimetry (PTV) and phase-sensitive constant temperature anemometry in pseudo-turbulence -- i.e. flow solely driven by rising bubbles -- were performed to investigate bubble clustering and to obtain the mean bubble rise velocity, distributions of bubble velocities and energy spectra at dilute gas concentrations ({$\alpha$} {$\leq$} 2.2 \%). To characterize the clustering the pair correlation function G(r, \texttheta ) was calculated. The deformable bubbles with equivalent bubble diameter db = 4--5 mm were found to cluster within a radial distance of a few bubble radii with a preferred vertical orientation. This vertical alignment was present at both small and large scales. For small distances also some horizontal clustering was found. The large number of data points and the non-intrusiveness of PTV allowed well-converged probability density functions (PDFs) of the bubble velocity to be obtained. The PDFs had a non-Gaussian form for all velocity components and intermittency effects could be observed. The energy spectrum of the liquid velocity fluctuations decayed with a power law of -3.2, different from the {$\approx$} -5/3 found for homogeneous isotropic turbulence, but close to the prediction -3 by Lance \& Bataille (J. Fluid Mech., vol. 222, 1991, p. 95) for pseudo-turbulence.},
  langid = {english},
  file = {/home/mq/Zotero/storage/LESEL7TS/Mercado et al. - 2010 - On bubble clustering and energy spectra in pseudo-.pdf}
}

@article{meredith-etal-2025,
  title = {Transient Behavior of Overflowing Gravity Currents Interacting with a Roughness Array},
  author = {Meredith, A. and McConnochie, C. and Nokes, R. and Cenedese, C.},
  year = 2025,
  month = mar,
  journal = {Physical Review Fluids},
  volume = {10},
  number = {3},
  pages = {033801},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevFluids.10.033801},
  urldate = {2025-03-20},
  abstract = {We present laboratory experiments that examine the density and velocity structure of gravity currents encountering an array of closely spaced roughness elements. We largely focus on experiments where the height of the current is significantly larger than the height of the roughness elements, such that the current flows over the top of the roughness array. The Froude number of the gravity current decreases as it flows over the roughness array and the decrease is dependent on the roughness height. The fluid density within the head of the current also decreases as the current travels and we show that the local Froude number, based on the buoyancy within the head, is constant. This highlights that the buoyancy within the head controls the local Froude number of the overflowing current. This contrasts with a gravity current flowing through a roughness array, where the absence of a prominent current head means that the local Froude number is controlled by a pressure gradient within the tail of the current. Finally, we examine the horizontal velocity field and volume fluxes above the roughness array. The volume fluxes allow us to infer the exchanges between the fluid within the roughness array, the current, and the ambient fluid, and for these exchanges to be compared to those of a smooth bed current. These results combine to give a detailed understanding of a gravity current flowing over a roughness array and provide a comparison against both smooth bed and through-flowing gravity currents.},
  file = {/home/mq/Zotero/storage/2ATNWJLL/Meredith et al. - 2025 - Transient behavior of overflowing gravity currents.pdf;/home/mq/Zotero/storage/TD7F47WR/PhysRevFluids.10.html}
}

@article{meredith-mcconnochie-nokes-2022,
  title = {Transient Behavior of Through-Flowing Gravity Currents Interacting with a Roughness Array},
  author = {Meredith, A. and McConnochie, C. and Nokes, R. and Cenedese, C.},
  year = 2022,
  month = jun,
  journal = {Physical Review Fluids},
