@article{pirozzoli-etal-2010,
  title = {Direct Numerical Simulation of Transonic Shock/Boundary Layer Interaction under Conditions of Incipient Separation},
  author = {Pirozzoli, S. and Bernardini, M. and Grasso, F.},
